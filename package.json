{
  "name": "ultra-health",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2",
      "shell-quote": "^1.11.0",
      "@vitest/mocker": "^5.0.3",
      "zod@<4.6.6": "^4.6.6",
      "uuid@<11.1.1": "^11.1.1",
      "decode-uri-component@<0.5.0": "^0.5.1"
    },
    "patchedDependencies": {
      "query-string@7.1.3": "patches/query-string@7.1.3.patch"
    }
  }
}
