{
  "name": "ultra-health",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2",
      "shell-quote": "^1.11.0",
      "@vitest/mocker": "^5.0.3"
    }
  }
}
